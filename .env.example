# Copy to .env and edit. Never commit .env.

# --- Server ---
# Bind address (default 127.0.0.1). Do not set it in Docker: the image uses 0.0.0.0.
# MOTIF_HOST=127.0.0.1
# Host names the browser uses to reach the app; other Hosts/Origins are refused (anti DNS-rebinding / CSRF).
# MOTIF_ALLOWED_HOSTS=127.0.0.1,localhost
MOTIF_PORT=8000
# Base directory for cache/ and library/ (default: project root; /data in Docker).
# MOTIF_DATA_DIR=
# Optional overrides; leave commented out unless set (an empty value is not "unset").
# MOTIF_CACHE_DIR=
# MOTIF_LIBRARY_DIR=
# SQLite file (default: <library>/motif.db).
# MOTIF_DB=
# PostgreSQL instead of SQLite (unset = SQLite). With the compose postgres profile:
# MOTIF_DATABASE_URL=postgresql://motif:motif@postgres:5432/motif
# Master key that encrypts API keys / S3 credentials saved in Settings (base64 of 32 random bytes).
# Unset = generated once into <library>/secret.key. Keep it: restoring a backup needs the same key.
# MOTIF_SECRET_KEY=
# Directory searched for *.sf2 (first one is used), or point at one file.
# MOTIF_SOUNDFONT_DIR=
# MOTIF_SOUNDFONT=
# Rendered songs kept in the cache (about 50 MB each).
MOTIF_CACHE_MAX=12

# --- AI briefs ---
# off | claude-cli | claude-api | openai   (claude-cli does not work in Docker)
AI_BACKEND=off
# Share of automatic songs that ask the AI (a typed prompt always does).
AI_RATIO=0.25
# Seconds before falling back to procedural generation.
AI_TIMEOUT=20
# claude-api
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# claude-cli
CLAUDE_CLI=claude
CLAUDE_CLI_MODEL=haiku

# --- OpenAI-compatible (AI_BACKEND=openai) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Set to 0 if the server rejects response_format=json_object.
OPENAI_JSON_MODE=1
# Ollama on the host (from Docker):
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   OPENAI_MODEL=llama3.1
#   OPENAI_API_KEY=ollama
# OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-4o-mini

# --- S3-compatible storage (AWS S3, MinIO, R2, ...). Empty bucket = local only ---
S3_BUCKET=
S3_PREFIX=motif/
# Leave empty for AWS. MinIO in compose: http://minio:9000
S3_ENDPOINT_URL=
S3_REGION=
# 0 = do not store saved/exported audio in S3.
S3_MEDIA=1
# Scheduled DB backups; 0 = manual only.
S3_BACKUP_INTERVAL_HOURS=0
# Read by boto3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- compose only (minio profile; export in your shell, compose does not read these from env_file) ---
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
