# Copy to .env and edit. Never commit .env.
# Required: MOTIF_ADMIN_EMAIL and MOTIF_ADMIN_PASSWORD. Everything else is optional;
# uncomment a line to change its default.
# AI providers and S3 backups are not set here: each user sets their own in Settings.

# --- Server ---
# Bind address (default 127.0.0.1). Do not set it in Docker: the image uses 0.0.0.0.
# MOTIF_HOST=127.0.0.1
# Host names the browser uses to reach the app; other Hosts/Origins are refused (anti DNS-rebinding / CSRF).
# MOTIF_ALLOWED_HOSTS=127.0.0.1,localhost
# MOTIF_PORT=8000
# Base directory for cache/ and library/ (default: project root; /data in Docker).
# MOTIF_DATA_DIR=
# MOTIF_CACHE_DIR=
# MOTIF_LIBRARY_DIR=
# SQLite file (default: <library>/motif.db).
# MOTIF_DB=
# PostgreSQL instead of SQLite (unset = SQLite). With the compose postgres profile:
# MOTIF_DATABASE_URL=postgresql://motif:motif@postgres:5432/motif
# Master key that encrypts AI and S3 keys saved in Settings (base64 of 32 random bytes).
# Unset = generated once into <library>/secret.key. Keep it: restoring a backup needs the same key.
# MOTIF_SECRET_KEY=
# Directory searched for *.sf2 (first one is used), or point at one file.
# MOTIF_SOUNDFONT_DIR=
# MOTIF_SOUNDFONT=
# Rendered songs kept in the cache (about 50 MB each).
# MOTIF_CACHE_MAX=12
# Songs rendered at the same time across all users (each render uses one CPU core).
# MOTIF_RENDER_WORKERS=2
# 1 = print the song plan instead of rendering (CLI).
# MOTIF_DRY_RUN=0

# --- Accounts ---
# Remove both for local mode (no login, one built-in user). Set = login required; the admin is
# created (or its password updated) from these on every start.
MOTIF_ADMIN_EMAIL=admin@example.com
MOTIF_ADMIN_PASSWORD=change-me-to-a-long-password
# Address people use to reach the app; invite and reset links start with it.
# MOTIF_PUBLIC_URL=https://motif.example.com
# Days a login stays valid.
# MOTIF_SESSION_DAYS=30

# --- Email (optional; invites and password resets). Without it the members page shows the link to copy ---
# MOTIF_SMTP_HOST=smtp.example.com
# MOTIF_SMTP_PORT=587
# MOTIF_SMTP_USER=motif@example.com
# MOTIF_SMTP_PASSWORD=smtp-password
# MOTIF_SMTP_FROM="Motif <motif@example.com>"
# starttls | ssl | none
# MOTIF_SMTP_TLS=starttls

# --- compose only (minio profile, a local S3 for backups; export in your shell, compose does not read these from env_file) ---
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
